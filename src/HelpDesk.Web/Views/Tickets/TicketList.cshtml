@model HelpDesk.Web.Models.TicketListViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Model.PageTitle</h1>
        <p class="page-subtitle">@Model.PageSubtitle</p>
    </div>
    <button onclick="openTicketModal()" class="btn btn-primary">
        <i class="fa-solid fa-ticket"></i> Create New Ticket
    </button>
</div>

<div class="card make-div-auto" style="padding:16px; margin-bottom:0; display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
    <div style="flex:1; min-width:200px; position:relative;">
        <i class="fa-solid fa-magnifying-glass" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--text-gray); font-size:13px;"></i>
        <input type="text" id="ticketSearch" placeholder="Search tickets..."
               style="width:100%; padding:10px 14px 10px 38px; border:1px solid var(--border); border-radius:8px; font-family:inherit; font-size:14px; box-sizing:border-box;" />
    </div>

    <div class="filter-dropdown-wrap">
        <button type="button" class="filter-btn" onclick="toggleFilterDropdown('statusFilter')">
            <i class="fa-solid fa-filter"></i> <span id="statusLabel">All Statuses</span> <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
        </button>
        <div id="statusFilter" class="filter-dropdown">
            <div class="filter-option selected" onclick="selectFilter('status', '', 'All Statuses', this)">All Statuses</div>
            <div class="filter-option" onclick="selectFilter('status', 'open', 'Open', this)">Open</div>
            <div class="filter-option" onclick="selectFilter('status', 'inprogress', 'In Progress', this)">In Progress</div>
            <div class="filter-option" onclick="selectFilter('status', 'resolved', 'Resolved', this)">Resolved</div>
            <div class="filter-option" onclick="selectFilter('status', 'closed', 'Closed', this)">Closed</div>
            <div class="filter-option" onclick="selectFilter('status', 'escalated', 'Escalated', this)">Escalated</div>
        </div>
    </div>

    <div class="filter-dropdown-wrap">
        <button type="button" class="filter-btn" onclick="toggleFilterDropdown('priorityFilter')">
            <i class="fa-solid fa-filter"></i> <span id="priorityLabel">All Priorities</span> <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
        </button>
        <div id="priorityFilter" class="filter-dropdown">
            <div class="filter-option selected" onclick="selectFilter('priority', '', 'All Priorities', this)">All Priorities</div>
            <div class="filter-option" onclick="selectFilter('priority', 'low', 'Low', this)">Low</div>
            <div class="filter-option" onclick="selectFilter('priority', 'medium', 'Medium', this)">Medium</div>
            <div class="filter-option" onclick="selectFilter('priority', 'high', 'High', this)">High</div>
            <div class="filter-option" onclick="selectFilter('priority', 'critical', 'Critical', this)">Critical</div>
        </div>
    </div>

    @if (Model.ShowSubmitterFilter)
    {
        <div class="filter-dropdown-wrap">
            <button type="button" class="filter-btn" onclick="toggleFilterDropdown('submitterFilter')">
                <i class="fa-solid fa-filter"></i> <span id="submitterLabel">All Submitters</span> <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
            </button>
            <div id="submitterFilter" class="filter-dropdown">
                <div class="filter-option selected" onclick="selectFilter('submitter', '', 'All Submitters', this)">All Submitters</div>
                @foreach (var name in Model.Tickets.Select(t => t.SubmittedByName).Where(n => n != null).Distinct())
                {
                    <div class="filter-option" onclick="selectFilter('submitter', '@name!.ToLower()', '@name', this)">@name</div>
                }
            </div>
        </div>
    }

    <div class="filter-dropdown-wrap">
        <button type="button" class="filter-btn" onclick="toggleFilterDropdown('dateFilter')">
            <i class="fa-solid fa-calendar"></i> <span id="dateLabel">Any Date</span> <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
        </button>
        <div id="dateFilter" class="filter-dropdown">
            <div class="filter-option selected" onclick="selectFilter('date', '', 'Any Date', this)">Any Date</div>
            <div class="filter-option" onclick="selectFilter('date', 'today', 'Today', this)">Today</div>
            <div class="filter-option" onclick="selectFilter('date', '7', 'Last 7 days', this)">Last 7 days</div>
            <div class="filter-option" onclick="selectFilter('date', '30', 'Last 30 days', this)">Last 30 days</div>
        </div>
    </div>

    <div class="filter-dropdown-wrap">
        <button type="button" class="filter-btn" onclick="toggleFilterDropdown('categoryFilter')">
            <i class="fa-solid fa-filter"></i> <span id="categoryLabel">All Categories</span> <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
        </button>
        <div id="categoryFilter" class="filter-dropdown">
            <div class="filter-option selected" onclick="selectFilter('category', '', 'All Categories', this)">All Categories</div>
            @foreach (var cat in Model.Tickets.Select(t => t.CategoryName).Where(c => c != null).Distinct())
            {
                <div class="filter-option" onclick="selectFilter('category', '@cat!.ToLower()', '@cat', this)">@cat</div>
            }
        </div>
    </div>
</div>

<div style="height:16px;"></div>

<div class="card make-div-auto tickets-card">
    <table class="tickets-table">
        <thead>
            <tr>
                <th>Ticket ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Category</th>
                <th>Submitted By</th>
                <th>Assigned To</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Tickets.Any())
            {
                <tr>
                    <td colspan="8" style="text-align:center; color:var(--text-gray); padding:32px;">
                        No tickets found.
                    </td>
                </tr>
            }
            @foreach (var ticket in Model.Tickets)
            {
                <tr data-title="@ticket.Title.ToLower()"
                    data-status="@ticket.Status.ToLower().Replace(" ", "")"
                    data-priority="@ticket.Priority.ToLower()"
                    data-category="@(ticket.CategoryName?.ToLower() ?? "")"
                    data-submitter="@(ticket.SubmittedByName?.ToLower() ?? "")"
                    data-created="@ticket.CreatedAt.ToString("yyyy-MM-dd")">
                    <td><a class="ticket-link" href="@Url.Action("Details", "Tickets", new { id = ticket.Id })">TKT-@ticket.Id.ToString().Substring(0, 8).ToUpper()</a></td>
                    <td>@ticket.Title</td>
                    <td><span class="badge badge-@ticket.Status.ToLower().Replace(" ", "")">@ticket.Status</span></td>
                    <td><span class="badge badge-@ticket.Priority.ToLower()">@ticket.Priority</span></td>
                    <td>@(ticket.CategoryName ?? "—")</td>
                    <td>@(ticket.SubmittedByName ?? "—")</td>
                    <td>@(ticket.AssignedToName ?? "Unassigned")</td>
                    <td>@ticket.CreatedAt.ToString("MMM dd, yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div id="pagination" style="display:flex; justify-content:center; gap:6px; margin-top:20px;"></div>

<script>
    let activeFilters = { status: '', priority: '', category: '', submitter: '', date: '' };
    let currentPage = 1;
    const pageSize = 10;

    function toggleFilterDropdown(id) {
        document.querySelectorAll('.filter-dropdown').forEach(d => {
            if (d.id !== id) d.style.display = 'none';
        });
        const dropdown = document.getElementById(id);
        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
    }

    function selectFilter(type, value, label, el) {
        activeFilters[type] = value;
        document.getElementById(type + 'Label').textContent = label;

        el.parentElement.querySelectorAll('.filter-option').forEach(o => o.classList.remove('selected'));
        el.classList.add('selected');

        currentPage = 1;
        applyFilters();
        document.querySelectorAll('.filter-dropdown').forEach(d => d.style.display = 'none');
    }

    function applyFilters() {
        const searchQuery = (document.getElementById('ticketSearch').value || '').trim().toLowerCase();
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        document.querySelectorAll('tbody tr[data-title]').forEach(row => {
            const title = (row.getAttribute('data-title') || '').toLowerCase();
            const status = (row.getAttribute('data-status') || '').toLowerCase();
            const priority = (row.getAttribute('data-priority') || '').toLowerCase();
            const category = (row.getAttribute('data-category') || '').toLowerCase();
            const submitter = (row.getAttribute('data-submitter') || '').toLowerCase();
            const createdStr = row.getAttribute('data-created');

            let matchesDate = true;
            if (activeFilters.date && createdStr) {
                const created = new Date(createdStr + 'T00:00:00');
                if (activeFilters.date === 'today') {
                    matchesDate = created.getTime() === today.getTime();
                } else {
                    const diffDays = (today - created) / 86400000;
                    matchesDate = diffDays >= 0 && diffDays <= parseInt(activeFilters.date, 10);
                }
            }

            const matchesSearch = !searchQuery || title.includes(searchQuery);
            const matchesStatus = !activeFilters.status || status === activeFilters.status;
            const matchesPriority = !activeFilters.priority || priority === activeFilters.priority;
            const matchesCategory = !activeFilters.category || category === activeFilters.category;
            const matchesSubmitter = !activeFilters.submitter || submitter === activeFilters.submitter;

            row.dataset.visible = (matchesSearch && matchesStatus && matchesPriority && matchesCategory && matchesSubmitter && matchesDate) ? '1' : '0';
        });

        applyPagination();
    }

    function applyPagination() {
        const allRows = Array.from(document.querySelectorAll('tbody tr[data-title]'));
        const visibleRows = allRows.filter(r => r.dataset.visible !== '0');
        const totalPages = Math.max(1, Math.ceil(visibleRows.length / pageSize));

        if (currentPage > totalPages) currentPage = totalPages;

        allRows.forEach(r => r.style.display = 'none');
        visibleRows.forEach((r, i) => {
            r.style.display = (i >= (currentPage - 1) * pageSize && i < currentPage * pageSize) ? '' : 'none';
        });

        renderPager(totalPages);
    }

    function renderPager(totalPages) {
        const el = document.getElementById('pagination');
        el.innerHTML = '';
        if (totalPages <= 1) return;

        for (let p = 1; p <= totalPages; p++) {
            const btn = document.createElement('button');
            btn.textContent = p;
            btn.className = 'btn ' + (p === currentPage ? 'btn-primary' : 'btn-outline');
            btn.style.minWidth = '36px';
            btn.onclick = () => { currentPage = p; applyPagination(); };
            el.appendChild(btn);
        }

        if (currentPage < totalPages) {
            const next = document.createElement('button');
            next.textContent = 'Next →';
            next.className = 'btn btn-outline';
            next.onclick = () => { currentPage++; applyPagination(); };
            el.appendChild(next);
        }
    }

    document.getElementById('ticketSearch').addEventListener('input', function () {
        currentPage = 1;
        applyFilters();
    });

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.filter-dropdown-wrap')) {
            document.querySelectorAll('.filter-dropdown').forEach(d => d.style.display = 'none');
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('tbody tr[data-title]').forEach(r => r.dataset.visible = '1');
        applyPagination();
    });
</script>