@{
    ViewData["Title"] = "Home";
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <script>window.location.href = '@Url.Action("Index", "Dashboard")';</script>
}
else
{
    <div class="login-page">
        <div class="login-card">
            <div class="login-icon"><i class="fa-solid fa-circle-question"></i></div>
            <h1>Welcome to HelpDesk</h1>
            <p>Sign in to access your IT support portal</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary" style="width:100%; justify-content:center; padding:14px;">
                <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign in with Keycloak
            </a>
        </div>
    </div>
}