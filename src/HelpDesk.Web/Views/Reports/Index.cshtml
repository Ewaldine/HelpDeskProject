@model HelpDesk.Shared.DTOs.ReportsResultDto
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Reports & Analytics</h1>
        <p class="page-subtitle">Track ticket trends and team performance.</p>
    </div>
    <button class="btn btn-outline"><i class="fa-solid fa-download"></i> Export Report</button>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div>
            <div class="stat-label">Resolution Rate</div>
            <div class="stat-value">@Model.ResolutionRate%</div>
        </div>
        <div class="stat-icon blue"><i class="fa-solid fa-arrow-trend-up"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Avg Response Time</div>
            <div class="stat-value">@Model.AvgResponseHours hrs</div>
        </div>
        <div class="stat-icon purple"><i class="fa-solid fa-arrow-trend-up"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Customer Satisfaction</div>
            <div class="stat-value">@Model.AvgSatisfaction/5</div>
        </div>
        <div class="stat-icon green"><i class="fa-solid fa-arrow-trend-up"></i></div>
    </div>
</div>

<div class="card make-div-auto">
    <div class="card-title">Weekly Ticket Activity</div>
    <canvas id="weeklyChart" height="90"></canvas>
</div>

<div class="card make-div-auto">
    <div class="card-title">Monthly Ticket Trend</div>
    <canvas id="monthlyChart" height="90"></canvas>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const weeklyLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeeklyActivity.Select(d => d.Day)));
        const createdData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeeklyActivity.Select(d => d.Created)));
        const resolvedData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeeklyActivity.Select(d => d.Resolved)));

        new Chart(document.getElementById('weeklyChart'), {
            type: 'bar',
            data: {
                labels: weeklyLabels,
                datasets: [
                    { label: 'Created', data: createdData, backgroundColor: '#3B82F6', borderRadius: 4 },
                    { label: 'Resolved', data: resolvedData, backgroundColor: '#22C55E', borderRadius: 4 }
                ]
            },
            options: { scales: { y: { beginAtZero: true } } }
        });

        const monthlyLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyTrend.Select(m => m.Month)));
        const monthlyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyTrend.Select(m => m.Count)));

        new Chart(document.getElementById('monthlyChart'), {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [{ label: 'Tickets Created', data: monthlyData, borderColor: '#3B82F6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true, tension: 0.3, pointBackgroundColor: '#3B82F6' }]
            },
            options: { scales: { y: { beginAtZero: true } } }
        });
    </script>
}