@model HelpDesk.Web.Models.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Manage your account and preferences.</p>
    </div>
</div>

<!-- Profile Settings -->
<div class="card make-div-auto">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <div style="width:36px; height:36px; border-radius:8px; background:var(--blue-light); display:flex; align-items:center; justify-content:center; color:var(--blue);">
            <i class="fa-regular fa-user"></i>
        </div>
        <div>
            <div style="font-weight:700; font-size:16px;">Profile Settings</div>
            <div style="font-size:13px; color:var(--text-gray);">Your personal information and display details.</div>
        </div>
    </div>

    <div style="display:flex; align-items:center; justify-content:space-between; padding:30px 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); margin-bottom:20px;">
        <div style="display:flex; align-items:center; gap:14px;">
            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="Profile" style="width:56px; height:56px; border-radius:8px; object-fit:cover;" />
            }
            else
            {
                <div class="user-avatar" style="width:56px; height:56px; font-size:20px;">
                    @(string.Concat(Model.FirstName.FirstOrDefault(), Model.LastName.FirstOrDefault()).ToString().ToUpper())
                </div>
            }

            <div>
                <div style="font-weight:700; font-size:16px; margin-bottom: 5px;">@Model.FirstName @Model.LastName</div>
                <div style="color:var(--text-gray); font-size:14px;">@Model.Email</div>
                <div style="margin-top:10px; display:flex; gap:8px;">
                    <span class="badge badge-open">@Model.Role</span>
                    <span class="badge" style="background:#F1F5F9; color:var(--text-gray);">@Model.Department</span>
                </div>
            </div>
        </div>
    </div>

    <form asp-controller="Settings" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0;">
            <div style="padding:10px; border-bottom:1px solid var(--border); grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr 1fr;">
                <div>
                    <div style="font-weight:600; font-size:14px;">Full name</div>
                </div>
                <div>
                    <div style="font-size:12px; color:var(--text-gray); margin-bottom:4px;">First name</div>
                    <input type="text" name="firstName" value="@Model.FirstName" style="border:none; background:none; font-size:14px; font-weight:600; width:100%;" />
                </div>
                <div>
                    <div style="font-size:12px; color:var(--text-gray); margin-bottom:4px;">Last name</div>
                    <input type="text" name="lastName" value="@Model.LastName" style="border:none; background:none; font-size:14px; font-weight:600; width:100%;" />
                </div>
            </div>

            <div style="padding:25px 0; border-bottom:1px solid var(--border); grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr 1fr; justify-content:space-between; align-items:center;">
                <div>
                    <div style="font-weight:600; font-size:14px;">Email address</div>
                </div>
                <div style="font-size:14px;"><i class="fa-regular fa-envelope" style="color:var(--text-gray); margin-right:8px;"></i>@Model.Email</div>
            </div>

            <div style="padding:25px 0; border-bottom:1px solid var(--border); grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr 1fr; justify-content:space-between; align-items:center;">
                <div>
                    <div style="font-weight:600; font-size:14px;">Phone number</div>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-phone" style="color:var(--text-gray);"></i>
                    <input type="text" name="phoneNumber" placeholder="+246 81 826 7371" value="@Model.PhoneNumber" style="border:none; background:none; font-size:14px; text-align:left;" />
                </div>
            </div>

            <div style="padding:25px 0; border-bottom:1px solid var(--border); grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr 1fr; justify-content:space-between; align-items:center;">
                <div>
                    <div style="font-weight:600; font-size:14px;">Department</div>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fa-regular fa-building" style="color:var(--text-gray);"></i>
                    <input type="text" name="department" value="@Model.Department" style="border:none; background:none; font-size:14px; text-align:left;" />
                </div>
            </div>

            <div style="padding:25px 0; grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr 1fr; justify-content:space-between; align-items:center;">
                <div>
                    <div style="font-weight:600; font-size:14px;">Office location</div>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-location-dot" style="color:var(--text-gray);"></i>
                    <input type="text" name="officeLocation" placeholder="e.g. Johannesburg — Floor 3" value="@Model.OfficeLocation" style="border:none; background:none; font-size:14px; text-align:left;" />
                </div>
            </div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; padding-top:16px; border-top:1px solid var(--border);">
            <span style="font-size:13px; color:var(--text-gray);">Last updated: @Model.LastUpdated.ToString("dd MMM yyyy")</span>
            <div style="display:flex; gap:10px;">
                <button type="button" class="btn btn-outline" onclick="window.location.reload()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </form>
</div>

<!-- Notification Preferences -->
<div class="card make-div-auto">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; border-bottom:1px solid var(--border);">
        <div style="width:36px; height:36px; border-radius:8px; background:#F3E8FF; display:flex; align-items:center; justify-content:center; color:#9333EA;">
            <i class="fa-regular fa-bell"></i>
        </div>
        <div style="padding:25px 0;margin-top:-10px; ">
            <div style="font-weight:700; font-size:16px;">Notification Preferences</div>
            <div style="font-size:13px; color:var(--text-gray);">Choose how and when you receive alerts.</div>
        </div>
    </div>

    <form asp-controller="Settings" asp-action="UpdateNotifications" method="post">
        @{
            var toggles = new (string Name, string Label, string Desc, bool Checked)[]
            {
                ("emailNotifications", "Email Notifications", "Receive email updates about your tickets", Model.EmailNotifications),
                ("ticketStatusUpdates", "Ticket Status Updates", "Get notified when ticket status changes", Model.TicketStatusUpdates),
                ("newComments", "New Comments", "Notifications for new comments on your tickets", Model.NewComments),
                ("weeklySummary", "Weekly Summary", "A weekly digest of your ticket activity", Model.WeeklySummary)
                ,("inAppNotifications", "In App", "Receive notifications inside the application (Notifications page)", Model.InAppNotifications)
            };
        }

        @foreach (var toggle in toggles)
        {
            <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 0; border-bottom:1px solid var(--border);">
                <div>
                    <div style="font-weight:600; font-size:14px;">@toggle.Label</div>
                    <div style="font-size:12px; color:var(--text-gray);">@toggle.Desc</div>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" name="@toggle.Name" value="true" @(toggle.Checked ? "checked" : "") />
                    <span class="toggle-slider"></span>
                </label>
            </div>
        }

        <div style="display:flex; justify-content:flex-end; padding-top:16px;">
            <button type="submit" class="btn btn-primary">Save Preferences</button>
        </div>
    </form>
</div>

<!-- Security -->
<div class="card make-div-auto"">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
        <div style="width:36px; height:36px; border-radius:8px; background:#FFEDD5; display:flex; align-items:center; justify-content:center; color:#F97316;">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div>
            <div style="font-weight:700; font-size:16px;">Security</div>
            <div style="font-size:13px; color:var(--text-gray);">Password, 2FA, and active sessions.</div>
        </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 0; border-bottom:1px solid var(--border);">
        <div>
            <div style="font-weight:600; font-size:14px;">Password</div>
            <div style="font-size:12px; color:var(--text-gray);">Managed through your organization's identity provider.</div>
        </div>
        <a href="https://login-dev.na.sbicdirectory.com:12443/realms/development/account/account-security/signing-in" target="_blank" class="btn btn-outline">
            Change Password
        </a>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 0; border-bottom:1px solid var(--border);">
    <div>
        <div style="font-weight:600; font-size:14px;">Two-Factor Authentication</div>
        <div style="font-size:12px; color:var(--text-gray);">Managed through your identity provider</div>
    </div>
        <a href="https://login-dev.na.sbicdirectory.com:12443/realms/development/account/account-security/signing-in" target="_blank" class="btn btn-outline">
        Manage in Keycloak
    </a>
</div>

    <div style="padding-top:16px;">
        <div style="font-weight:600; font-size:14px; margin-bottom:10px;">Active Sessions</div>
        <div style="background:var(--bg); border-radius:8px; padding:14px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-weight:600; font-size:14px;">Current Device</div>
                <div style="font-size:12px; color:var(--text-gray);">Browser session · @DateTime.Now.ToString("yyyy")</div>
            </div>
            <div style="font-size:13px; color:var(--green); font-weight:600;">
                <i class="fa-solid fa-circle" style="font-size:8px;"></i> Active now
            </div>
        </div>
    </div>
</div>