@model HelpDesk.Web.Models.NotificationViewModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="page-header" style="align-items:center; gap:12px;">
    <div>
        <h1 class="page-title">Notifications</h1>
        @if (Model.Notifications == null || !Model.Notifications.Any())
        {
            <p class="page-subtitle">You're all caught up.</p>
        }
        else
        {
            <p class="page-subtitle">You have @Model.Notifications.Count unread notifications.</p>
        }
    </div>
    @if (Model.Notifications != null && Model.Notifications.Any())
    {
        <div style="margin-left:auto; display:flex; gap:12px; align-items:center;">
            <form asp-action="MarkAllRead" method="post" style="margin:0;">
                <button type="submit" class="btn btn-outline"><i class="fa-solid fa-check"></i> Mark all read</button>
            </form>
            <form asp-action="ClearAll" method="post" style="margin:0;">
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Clear all</button>
            </form>
        </div>
    }
</div>

<div class="notifications-tabs" style="margin-bottom:18px;">
    <a href="#" class="tab active" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text); text-decoration:none; font-weight:700;">All <span style="background:var(--blue); color:white; padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">@(Model.Notifications?.Count ?? 0)</span></a>
    <a href="#" class="tab" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">Tickets <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
    <a href="#" class="tab" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">Comments <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
    <a href="#" class="tab" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">Assignments <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
    <a href="#" class="tab" style="padding:10px 14px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">System <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
</div>

@if (Model.Notifications == null || !Model.Notifications.Any())
{
    <div class="card make-div-auto" style="padding:48px; text-align:center; border-radius:12px;">
        <div style="font-size:48px; color:#E6EDF8; margin-bottom:18px;"><i class="fa-solid fa-bell-slash"></i></div>
        <div style="font-weight:700; font-size:18px; margin-bottom:8px;">No notifications here</div>
        <div style="color:var(--text-gray);">When something needs your attention, it'll show up here.</div>
    </div>
}
else
{
    <div class="notifications-tabs" style="margin-bottom:18px;">
        <a href="#" class="tab active" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text); text-decoration:none; font-weight:700;">All <span style="background:var(--blue); color:white; padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">@Model.Notifications.Count</span></a>
        <a href="#" class="tab" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">Tickets <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
        <a href="#" class="tab" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">Comments <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
        <a href="#" class="tab" style="padding:10px 14px; margin-right:8px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">Assignments <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
        <a href="#" class="tab" style="padding:10px 14px; border-radius:8px; background:transparent; color:var(--text-gray); text-decoration:none;">System <span style="background:#EEF2FF; color:var(--blue); padding:2px 8px; border-radius:12px; font-size:12px; margin-left:8px;">1</span></a>
    </div>
    <div class="card make-div-auto">
        <div style="padding:16px;">
            <h3 style="font-size:13px; color:var(--text-gray); text-transform:uppercase; font-weight:700; letter-spacing:0.06em;">New</h3>
        </div>

        <div style="display:flex; flex-direction:column; gap:0;">
            @foreach (var n in Model.Notifications.Take(5))
            {
                <div style="display:flex; gap:12px; padding:18px 20px; border-top:1px solid var(--border); align-items:flex-start;">
                    <div style="width:44px; height:44px; border-radius:50%; background:#F8FAFC; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <i class="fa-solid fa-bell" style="color:var(--blue);"></i>
                    </div>
                    <div style="flex:1;">
                        <div style="font-weight:700; font-size:15px; margin-bottom:6px;">@n.Title</div>
                        <div style="color:var(--text-gray); font-size:14px; margin-bottom:8px;">@n.Message
                            @if (n.TicketId != null)
                            {
                                <a href="@Url.Action("Details", "Tickets", new { id = n.TicketId })" style="display:inline-block; margin-left:8px; color:var(--blue); font-weight:600;">View TKT-@n.TicketId.ToString().Substring(0,8).ToUpper()</a>
                            }
                        </div>
                        <div style="font-size:12px; color:var(--text-gray);">@n.CreatedAt.ToString("h:mm tt")</div>
                    </div>
                    <div style="width:8px; height:8px; background:var(--blue); border-radius:50%; margin-top:8px;">&nbsp;</div>
                </div>
            }
        </div>

        <div style="padding:16px; border-top:1px solid var(--border); color:var(--text-gray);">Earlier</div>
        <div style="display:flex; flex-direction:column; gap:0;">
            @foreach (var n in Model.Notifications.Skip(5))
            {
                <div style="display:flex; gap:12px; padding:18px 20px; border-top:1px solid var(--border); align-items:flex-start;">
                    <div style="width:44px; height:44px; border-radius:50%; background:#F8FAFC; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <i class="fa-solid fa-check-circle" style="color:var(--green);"></i>
                    </div>
                    <div style="flex:1;">
                        <div style="font-weight:700; font-size:15px; margin-bottom:6px;">@n.Title</div>
                        <div style="color:var(--text-gray); font-size:14px; margin-bottom:8px;">@n.Message
                            @if (n.TicketId != null)
                            {
                                <a href="@Url.Action("Details", "Tickets", new { id = n.TicketId })" style="display:inline-block; margin-left:8px; color:var(--blue); font-weight:600;">View TKT-@n.TicketId.ToString().Substring(0,8).ToUpper()</a>
                            }
                        </div>
                        <div style="font-size:12px; color:var(--text-gray);">@n.CreatedAt.ToString("MMM d, h:mm tt")</div>
                    </div>
                </div>
            }
        </div>

    </div>
}
