@model HelpDesk.Web.Models.TeamViewModel
@{
    ViewData["Title"] = "My Team";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My Team</h1>
        <p class="page-subtitle">Workload, capacity, and status for your technicians.</p>
    </div>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div>
            <div class="stat-value">@Model.ResolvedThisWeek</div>
            <div class="stat-label">Resolved this week</div>
        </div>
        <div class="stat-icon blue"><i class="fa-solid fa-check"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-value">@Model.TotalOpenTickets</div>
            <div class="stat-label">Total open tickets</div>
        </div>
        <div class="stat-icon" style="background:#FFEDD5; color:#F97316;"><i class="fa-solid fa-triangle-exclamation"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-value">@Model.TeamAvgResolutionHours.ToString("0.0") hrs</div>
            <div class="stat-label">Team avg resolution</div>
        </div>
        <div class="stat-icon green"><i class="fa-solid fa-check"></i></div>
    </div>
</div>

@foreach (var member in Model.Members)
{
    var loadPercent = member.Capacity > 0 ? (member.OpenTickets * 100 / member.Capacity) : 0;
    var (statusLabel, statusColor, statusBg) = loadPercent switch
    {
        >= 100 => ("Overloaded", "var(--red)", "var(--red-bg)"),
        >= 80 => ("High load", "var(--orange)", "var(--orange-bg)"),
        _ => ("Available", "var(--green)", "var(--green-bg)")
    };
    var barClass = loadPercent >= 100 ? "high" : loadPercent >= 80 ? "medium" : "low";

    <div class="card make-div-auto" style="margin-bottom:20px;display:grid; grid-template-columns: 1fr 160px; gap:24px; align-items:start;">
        <div style="display:col; justify-content:space-between; align-items:flex-start;">
            <div>
                <div style="margin-bottom:20px;display:grid; grid-template-columns: 1fr 340px; gap:24px; align-items:start;">
                    <div style="display:flex; gap:16px;">
                        <div class="workload-avatar-wrap">
                            <div>
                                <div class="user-avatar" style="width:56px; height:56px; font-size:20px;">
                                    @(string.Concat(member.FirstName.FirstOrDefault(), member.LastName.FirstOrDefault()).ToString().ToUpper())
                                </div>

                            </div>
                            <div class="status-dot @(member.IsOnline ? "online" : "offline")" style="width:14px; height:14px;"></div>
                        </div>
                        <div>
                            <div style="font-weight:700; font-size:17px;">@member.FirstName @member.LastName</div>
                            <div style="color:@(member.IsOnline ? "var(--green)" : "var(--text-gray)"); font-size:13px; margin-bottom:6px;">
                                @(member.IsOnline ? "Online" : "Offline")
                            </div>
                            <div style="display:flex; gap:16px; color:var(--text-gray); font-size:13px;">
                                <span><i class="fa-regular fa-envelope"></i> @member.Email</span>
                            </div>
                        </div>
                    </div>
                    <div style="margin-left:80%;">
                        <span class="badge" style="background:@statusBg; color:@statusColor;">@statusLabel</span>
                    </div>
                </div>
            </div>
            <div style="margin-top:20px; margin-left:73px">
                <div style="display:flex; justify-content:space-between; font-size:13px; color:var(--text-gray); margin-bottom:6px;">
                    <span>Workload capacity</span>
                    <span style="color:@statusColor; font-weight:600;">@member.OpenTickets/@member.Capacity tickets</span>
                </div>
                <div class="workload-bar-track">
                    <div class="workload-bar-fill @barClass" style="width:@(Math.Min(loadPercent, 100))%;"></div>
                </div>
            </div>
           
        </div>
        <div>
            <div style="align-items:flex-start; gap:32px; width:auto; border-left:2px solid var(--border);;">
                <div style="text-align:right;">
                    <div style="font-size:22px; font-weight:700;">@member.ResolvedThisWeek</div>
                    <div style="font-size:12px; color:var(--text-gray);">Resolved this week</div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:22px; font-weight:700;">@member.AvgResolutionHours.ToString("0.0") hrs</div>
                    <div style="font-size:12px; color:var(--text-gray);">Avg resolution</div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:22px; font-weight:700;">@member.OpenTickets</div>
                    <div style="font-size:12px; color:var(--text-gray);">Open tickets</div>
                </div>
            </div>

        </div>

        
    </div>
}