@model HelpDesk.Web.Models.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back! Here's your ticket overview.</p>
    </div>
    <button onclick="openTicketModal()" class="btn btn-primary">
        <i class="fa-solid fa-ticket"></i> Create New Ticket
    </button>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div>
            <div class="stat-label">My Open Tickets</div>
            <div class="stat-value">@Model.OpenTicketCount</div>
        </div>
        <div class="stat-icon blue"><i class="fa-solid fa-ticket"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Resolved This Month</div>
            <div class="stat-value">@Model.ResolvedThisMonth</div>
        </div>
        <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Avg Resolution Time</div>
            <div class="stat-value">@Model.AvgResolutionHours hrs</div>
        </div>
        <div class="stat-icon purple"><i class="fa-solid fa-clock"></i></div>
    </div>
</div>

<div class="card make-div-auto">
    <div class="card-title">My Recent Tickets</div>
    <table>
        <thead>
            <tr>
                <th>Ticket ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Created Date</th>
                <th>Last Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.RecentTickets)
            {
                <tr>
                    <td><a class="ticket-link" href="@Url.Action("Details", "Tickets", new { id = ticket.Id })">TKT-@ticket.Id.ToString().Substring(0, 8).ToUpper()</a></td>
                    <td>@ticket.Title</td>
                    <td><span class="badge badge-@ticket.Status.ToLower().Replace(" ", "")">@ticket.Status</span></td>
                    <td><span class="badge badge-@ticket.Priority.ToLower()">@ticket.Priority</span></td>
                    <td>@ticket.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>@ticket.UpdatedAt.ToString("MMM dd, yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>